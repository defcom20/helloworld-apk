<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <EditText
        android:id="@+id/campoUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="URL de tu plataforma"
        android:inputType="textUri" />

    <EditText
        android:id="@+id/campoSelectorBoton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Selector CSS del botón (ej: button.send-test)" />

    <EditText
        android:id="@+id/campoEsperado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Texto esperado en el mensaje (ej: exitoso)" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/botonIniciar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Iniciar" />

        <Button
            android:id="@+id/botonDetener"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Detener" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/textoEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado: listo" />
    </ScrollView>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

</LinearLayout>
